        <mxCell id="moxp4zKkcIowtqQu5v4O-18" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Типы обучения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
