        <mxCell id="moxp4zKkcIowtqQu5v4O-99" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Рекомендательные система&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="-1300" y="2260" width="320" height="40" as="geometry" />
