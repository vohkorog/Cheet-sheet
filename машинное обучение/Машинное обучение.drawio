          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-142" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;K-ближайших соседей (KNN Regression)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;gradientColor=#66B2FF;gradientDirection=north;" parent="1" vertex="1">
          <mxGeometry x="-3200" y="700" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-166" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="moxp4zKkcIowtqQu5v4O-143" target="moxp4zKkcIowtqQu5v4O-165" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-143" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Нейронные сети (MLP, CNN, RNN, Transformer)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;gradientColor=#66B2FF;gradientDirection=north;" parent="1" vertex="1">
          <mxGeometry x="-3200" y="780" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-145" value="&lt;h3 style=&quot;font-weight: 500; font-size: 18.288px; line-height: 1.5; margin: 18.288px 0px 13.716px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Что выбирать на практике?&lt;/strong&gt;&lt;/h3&gt;&lt;ul style=&quot;margin: 13.716px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Для быстрого baseline&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ Линейная регрессия / Ridge / Lasso.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Для баланса точности и скорости&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ Random Forest / XGBoost.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Максимальная точность&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ Градиентный бустинг (LightGBM, XGBoost) или нейросети.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Мало данных + нелинейность&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ SVR / KNN.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Интерпретируемость&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ Линейные модели, деревья (с ограничением глубины).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 13.716px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Градиентный бустинг (особенно LightGBM и XGBoost) и случайный лес чаще всего используются в соревнованиях (Kaggle) и промышленных задачах из-за их высокой точности и устойчивости.&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-2740" y="-10" width="560" height="400" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-146" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Простота и интерпретируемость.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Быстрая работа даже на больших данных.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Используется как baseline-модель.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-3710" y="-100" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-148" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Ridge (L2-регуляризация) – уменьшает переобучение, но не обнуляет коэффициенты.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Lasso (L1-регуляризация) – отбирает признаки, обнуляя слабые коэффициенты.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Elastic Net – гибрид Ridge и Lasso, лучший выбор при мультиколлинеарности.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-4340" y="-140" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-150" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Работает &quot;из коробки&quot; без тонкой настройки.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Устойчив к выбросам и шуму.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Хорошо обрабатывает нелинейные зависимости.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-4800" y="-120" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-152" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Самые мощные алгоритмы для табличных данных.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Высокая точность, но требует настройки гиперпараметров.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;XGBoost – классика, LightGBM – быстрее на больших данных, CatBoost – лучше работает с категориальными признаками.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-5190" y="485" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-161" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Эффективен в задачах с небольшим объемом данных.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Хорошо работает с нелинейными зависимостями (с ядрами: RBF, полиномиальное).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-4950" y="670" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-163" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Прост в реализации, но медленный на больших данных.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;Подходит, если данные имеют локальные закономерности.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-4640" y="880" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-165" value="&lt;ul style=&quot;margin: 4px 0px 0px; padding-left: 27.432px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;MLP (многослойный перцептрон) – для табличных данных.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;CNN – для данных с пространственной структурой (например, изображения).&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 4px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px; margin-right: 0px; margin-bottom: 0px !important; margin-left: 0px; font-size: 16.002px; line-height: 28.575px;&quot;&gt;RNN / Transformer – для временных рядов и текстов.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-4135" y="1040" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-171" value="&lt;h2 style=&quot;font-weight: 500; font-size: 22.86px; line-height: 1.5; margin: 18.288px 0px 13.716px; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Когда выбирать регрессию, а когда классификацию?&lt;/strong&gt;&lt;/h2&gt;&lt;div class=&quot;markdown-table-wrapper&quot; style=&quot;overflow-x: auto; color: rgb(64, 64, 64); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Noto Sans&amp;quot;, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Oxygen, &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 16.002px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;table style=&quot;border-collapse: collapse; width: max-content; max-width: max-content;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;color: rgb(64, 64, 64); padding: 10px 10px 10px 0px; border-bottom: 0.8px solid rgb(187, 187, 187); border-top: none; font-weight: 600; font-size: 15px; line-height: 1.72; border-right-color: rgb(187, 187, 187); border-left-color: rgb(187, 187, 187); text-align: left;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Критерий&lt;/strong&gt;&lt;/th&gt;&lt;th style=&quot;color: rgb(64, 64, 64); padding: 10px; border-bottom: 0.8px solid rgb(187, 187, 187); border-top: none; font-weight: 600; font-size: 15px; line-height: 1.72; border-right-color: rgb(187, 187, 187); border-left-color: rgb(187, 187, 187); text-align: left;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Регрессия&lt;/strong&gt;&lt;/th&gt;&lt;th style=&quot;color: rgb(64, 64, 64); padding: 10px; border-bottom: 0.8px solid rgb(187, 187, 187); border-top: none; font-weight: 600; font-size: 15px; line-height: 1.72; border-right-color: rgb(187, 187, 187); border-left-color: rgb(187, 187, 187); text-align: left;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Классификация&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;padding: 10px 10px 10px 0px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Целевая переменная&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 10px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;Числовая (например, цена, температура)&lt;/td&gt;&lt;td style=&quot;padding: 10px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;Категориальная (например, &quot;да/нет&quot;, классы)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 10px 10px 10px 0px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Примеры задач&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 10px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;Прогнозирование продаж, оценка стоимости&lt;/td&gt;&lt;td style=&quot;padding: 10px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;Распознавание изображений, спам-фильтрация&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 10px 10px 10px 0px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;Метрики качества&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 10px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;MSE, RMSE, R²&lt;/td&gt;&lt;td style=&quot;padding: 10px; border-bottom: 0.8px solid rgb(229, 229, 229); font-size: 15px; line-height: 1.72; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); min-width: 100px; max-width: max(30vw, 320px);&quot;&gt;Accuracy, Precision, Recall, F1, ROC-AUC&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
