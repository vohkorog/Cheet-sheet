        <mxCell id="moxp4zKkcIowtqQu5v4O-6" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Обучение с учителем&lt;br&gt;(Supervised learning)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-1430" y="560" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="moxp4zKkcIowtqQu5v4O-7" target="moxp4zKkcIowtqQu5v4O-46" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="moxp4zKkcIowtqQu5v4O-7" target="moxp4zKkcIowtqQu5v4O-47" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-7" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Обучение без учителя&amp;nbsp;&lt;br&gt;(Unsupervised learning)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-40" y="760" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-8" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Обучение с частичным подключением учителя&lt;br&gt;(reinforcement learning)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="880" y="560" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="moxp4zKkcIowtqQu5v4O-9" target="moxp4zKkcIowtqQu5v4O-107" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-9" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Обучение с подкреплением&lt;br&gt;(semi-supervised learning)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="520" y="760" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-16" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px; transition: opacity 0.2s ease-in-out, color 0.2s ease-in-out, text-decoration 0.2s ease-in-out, background-color 0.2s ease-in-out, -webkit-text-decoration 0.2s ease-in-out; font-weight: bolder; quotes: &amp;quot;«&amp;quot; &amp;quot;»&amp;quot;; -webkit-font-smoothing: antialiased; color: rgb(51, 51, 51); font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif; background-color: rgb(255, 255, 255);&quot;&gt;Машинное обучение (МО)&lt;/span&gt;&lt;span style=&quot;font-size: 20px; color: rgb(51, 51, 51); font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif; background-color: rgb(255, 255, 255); float: none; display: inline !important;&quot;&gt;&amp;nbsp;— это область знаний и исследований в области искусственного интеллекта, которая занимается разработкой алгоритмов и статистических моделей, которые могут аппроксимировать данные, обучаться на них, обобщать их на невидимые зависимости и, таким образом, выполнять задачи без явных инструкций.&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="-370" y="-190" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="moxp4zKkcIowtqQu5v4O-17" target="moxp4zKkcIowtqQu5v4O-58" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
