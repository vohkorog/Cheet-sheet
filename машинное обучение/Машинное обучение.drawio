        <mxCell id="moxp4zKkcIowtqQu5v4O-101" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Обнаружение признаков&amp;nbsp;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
