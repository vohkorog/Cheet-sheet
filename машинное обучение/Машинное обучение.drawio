        <mxCell id="moxp4zKkcIowtqQu5v4O-138" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Градиентный бустинг (XGBoost, LightGBM, CatBoost)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;gradientColor=#66B2FF;gradientDirection=north;" parent="1" vertex="1">
          <mxGeometry x="-3200" y="540" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-162" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="moxp4zKkcIowtqQu5v4O-139" target="moxp4zKkcIowtqQu5v4O-161" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moxp4zKkcIowtqQu5v4O-139" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Метод опорных векторов (SVR)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;gradientColor=#66B2FF;gradientDirection=north;" parent="1" vertex="1">
          <mxGeometry x="-3200" y="620" width="320" height="40" as="geometry" />
